package-as: Luckys_Loot_Wishlist

ignore:
  - tests

move-folders:
  Luckys_Loot_Wishlist/src: Luckys_Loot_Wishlist

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  src/Libs/LuckysUtils:
    url: https://github.com/LuckyPhilDev/LuckyUtils
    tag: latest

enable-nolib-creation: no
